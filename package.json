{
  "name": "nitro-test-utils",
  "type": "module",
  "version": "4.0.1",
  "packageManager": "pnpm@12.16.1",
  "description": "Test Nitro apps with Vitest – development mode, production builds, and Cloudflare bindings",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/nitro-test-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/nitro-test-utils.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/nitro-test-utils/issues"
  },
  "keywords": [
    "cloudflare",
    "nitro",
    "testing",
    "vitest"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit && pnpm -r test:types",
    "release": "bumpp",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "nitro": "*",
    "vitest": "^4 || ^5"
  },
  "dependencies": {
    "cookie-es": "catalog:",
    "exsolve": "catalog:",
    "get-port-please": "catalog:",
    "httpxy": "catalog:",
    "ofetch": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-flat-config-utils": "catalog:",
    "nitro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
